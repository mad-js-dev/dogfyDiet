    "@pinia/nuxt": "^0.11.3",
    "gsap": "^3.14.2",
    "nuxt": "^3.21.1",
    "pinia": "^3.0.4",
    "sass": "^1.97.3",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
