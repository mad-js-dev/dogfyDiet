        "bright": "var(--neutral-10)",
        "inverse": "var(--neutral-100)",
        "inverse-primary": "var(--primary-green-80)"
      }
    }
  },
  "dark-roles": {
    "primary": {
      "main": "var(--primary-green-30)",
      "on": "var(--primary-green-100)",
      "container": "var(--primary-green-50)",
      "on-container": "var(--primary-green-100)",
      "inverse": "var(--primary-green-80)"
    },
    "secondary": {
      "main": "var(--accent-orange-30)",
      "on": "var(--accent-orange-100)",
      "container": "var(--accent-orange-50)",
