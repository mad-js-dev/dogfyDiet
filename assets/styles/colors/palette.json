{
  "base-brand-colors": {
    "primary-green": "#00B67A",
    "accent-orange": "#EF6948",
    "accent-yellow": "#ffc800",
    "neutral": "#767676"
  },
  "base-semantic-colors": {
    "success": "#0aaa46",
    "error": "#d80003",
    "warning": "#ffc800",
    "info": "#1976d2"
  },
  "palette-adjustments": {
    "10": {"lightness": "-60%", "saturation": "-10%"},
    "20": {"lightness": "-45%", "saturation": "-5%"},
    "30": {"lightness": "-30%", "saturation": "-2%"},
    "40": {"lightness": "-20%"},
    "50": {"lightness": "-10%"},
    "60": {"lightness": "0%"},
    "70": {"lightness": "15%"},
    "80": {"lightness": "30%"},
    "90": {"lightness": "45%"},
    "95": {"lightness": "55%", "saturation": "-20%"},
    "98": {"lightness": "65%", "saturation": "-40%"},
    "99": {"lightness": "75%", "saturation": "-60%"},
    "100": {"lightness": "100%"}
  },
  "light-roles": {
    "primary": {
      "main": "var(--primary-green-40)",
      "on": "var(--primary-green-100)",
      "container": "var(--primary-green-90)",
      "on-container": "var(--primary-green-10)",
      "inverse": "var(--primary-green-80)"
    },
    "secondary": {
      "main": "var(--accent-orange-40)",
      "on": "var(--accent-orange-100)",
      "container": "var(--accent-orange-70)",
      "on-container": "var(--accent-orange-10)"
    },
    "tertiary": {
      "main": "var(--accent-yellow-40)",
      "on": "var(--accent-yellow-100)",
      "container": "var(--accent-yellow-70)",
      "on-container": "var(--accent-yellow-10)"
    },
    "neutral": {
      "surface": {
        "dim": "var(--neutral-70)",
        "regular": "var(--neutral-90)",
        "bright": "var(--neutral-100)",
        "inverse": "var(--neutral-10)",
        "inverse-primary": "var(--primary-green-80)"
      },
      "on-surface": {
        "dim": "var(--neutral-20)",
        "regular": "var(--neutral-10)",
        "bright": "var(--neutral-0)",
        "inverse": "var(--neutral-100)",
        "inverse-primary": "var(--primary-green-80)"
      },
      "surface-variant": {
        "dim": "var(--neutral-60)",
